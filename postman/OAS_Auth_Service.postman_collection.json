{
  "info": {
    "name": "OAS Auth Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual walkthrough of the user and token lifecycle against the deployed environment. Fill in the details in each request by hand; nothing is captured automatically. Set api_key in the collection variables to an editors-scoped key, because Create User uses the catalogue's write route."
  },
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"test\",\n  \"lastName\": \"user\",\n  \"email\": \"test.user@example.com\",\n  \"password\": \"test123\",\n  \"pin\": \"123456\",\n  \"orgId\": \"org-000000000001\",\n  \"orgName\": \"Ethiopian Institute of Agricultural Research\",\n  \"functionalRole\": \"MAKER\",\n  \"displayName\": \"FIELD_OFFICER\",\n  \"dateOfBirth\": \"1994-04-12\",\n  \"gender\": \"MALE\",\n  \"phoneNumber\": \"+251-911-000-001\",\n  \"location0Id\": \"loc-000000000001\",\n  \"location0Name\": \"Ethiopia\",\n  \"location1Id\": \"loc-000000000002\",\n  \"location1Name\": \"Oromia\",\n  \"location2Id\": \"loc-000000000003\",\n  \"location2Name\": \"East Shewa\",\n  \"location3Id\": \"loc-000000000004\",\n  \"location3Name\": \"Bishoftu\",\n  \"location4Id\": \"loc-000000000005\",\n  \"location4Name\": \"Kebele 05\",\n  \"createdBy\": \"\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/add",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "add"
          ]
        },
        "description": "Edit the details below. Copy the userId from the response for the later requests."
      }
    },
    {
      "name": "Read User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{catalogue_url}}/user/v1/read/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "read",
            "PASTE_USER_ID"
          ]
        },
        "description": "Everything the catalogue stores except the password and pin, which never leave postgres."
      }
    },
    {
      "name": "Verify Credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"test123\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/verify",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "verify"
          ]
        },
        "description": "The call auth-service makes internally during login. 401 for a bad password, 403 if not ACTIVE."
      }
    },
    {
      "name": "Verify PIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\",\n  \"pin\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/verify_pin",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "verify_pin"
          ]
        },
        "description": "The call auth-service makes internally during PIN login. 401 for a wrong PIN, 403 if not ACTIVE or \"PIN has expired\". No Kong route by design, so it only works against a local catalogue."
      }
    },
    {
      "name": "Create Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"test123\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_create",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_create"
          ]
        },
        "description": "Login. Copy access_token and refresh_token from the response. 401 AUTH_CREDENTIAL_EXPIRED when the password is past its passwordExpiresOn."
      }
    },
    {
      "name": "Create Token (PIN enrolment)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"test123\",\n  \"pinLogin\": true,\n  \"deviceLabel\": \"Test device\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_create",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_create"
          ]
        },
        "description": "Login that also enrols this device for PIN login. Copy deviceHandle from the response."
      }
    },
    {
      "name": "Create Token with PIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceHandle\": \"PASTE_DEVICE_HANDLE\",\n  \"pin\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_create_pin",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_create_pin"
          ]
        },
        "description": "PIN login with the deviceHandle from Create Token (PIN enrolment). 401 AUTH_CREDENTIAL_EXPIRED when the PIN is past its pinExpiresOn (no attempt spent)."
      }
    },
    {
      "name": "Create Token with PIN (wrong PIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceHandle\": \"PASTE_DEVICE_HANDLE\",\n  \"pin\": \"000000\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_create_pin",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_create_pin"
          ]
        },
        "description": "A wrong PIN: 401 for attempts 1-4; the fifth returns 401 AUTH_TOKEN_REVOKED and removes the device."
      }
    },
    {
      "name": "Change PIN",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"test123\",\n  \"newPin\": \"135790\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/update/PASTE_USER_ID/pin",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "update",
            "PASTE_USER_ID",
            "pin"
          ]
        },
        "description": "Catalogue PIN change, authorised by the current password. newPin must be 6 digits; optional pinExpiresOn sets its expiry. Then Create Token with PIN works with the new PIN on the same device."
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_refresh",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_refresh"
          ]
        },
        "description": "Exchanges the refresh token from Create Token for a fresh pair. The access token lives 5 minutes; the session behind it lasts hours, so this is how a client stays logged in without re-sending the password. Copy the new access_token onward; the old one keeps working until it expires."
      }
    },
    {
      "name": "Validate Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_ACCESS_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_validate",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_validate"
          ]
        },
        "description": "Verified locally against Keycloak's signing key and the Redis denylist. Returns the claims."
      }
    },
    {
      "name": "Invalidate Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_ACCESS_TOKEN\",\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_token_invalidate",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_token_invalidate"
          ]
        },
        "description": "Kills this one token and ends its Keycloak session. Validate Token then returns 401 revoked, but a fresh Create Token still works. Logout keeps PIN devices."
      }
    },
    {
      "name": "Update Catalogue User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"test\",\n  \"lastName\": \"user\",\n  \"email\": \"test.user@example.com\",\n  \"orgId\": \"org-000000000001\",\n  \"orgName\": \"Ethiopian Institute of Agricultural Research\",\n  \"functionalRole\": \"MAKER\",\n  \"displayName\": \"FIELD_OFFICER\",\n  \"dateOfBirth\": \"1994-04-12\",\n  \"gender\": \"MALE\",\n  \"phoneNumber\": \"+251-911-000-001\",\n  \"location0Id\": \"loc-000000000001\",\n  \"location0Name\": \"Ethiopia\",\n  \"location1Id\": \"loc-000000000002\",\n  \"location1Name\": \"Oromia\",\n  \"location2Id\": \"loc-000000000003\",\n  \"location2Name\": \"East Shewa\",\n  \"location3Id\": \"loc-000000000004\",\n  \"location3Name\": \"Bishoftu\",\n  \"location4Id\": \"loc-000000000005\",\n  \"location4Name\": \"Kebele 05\",\n  \"passwordExpiresOn\": \"2999-01-01T00:00:00Z\",\n  \"pinExpiresOn\": \"2999-01-01T00:00:00Z\",\n  \"createdBy\": \"\"\n}"
        },
        "url": {
          "raw": "{{catalogue_url}}/user/v1/update/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "update",
            "PASTE_USER_ID"
          ]
        },
        "description": "Catalogue edit, which also syncs the profile to auth (auth_user_update); omitted password and pin are kept. Set passwordExpiresOn or pinExpiresOn to a past date to see Create Token or Create Token with PIN return 401 AUTH_CREDENTIAL_EXPIRED, then set it back."
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\",\n  \"orgId\": \"org-000000000001\",\n  \"functionalRole\": \"MAKER\",\n  \"email\": \"test.user@example.com\",\n  \"firstName\": \"test\",\n  \"lastName\": \"user\",\n  \"orgName\": \"Ethiopian Institute of Agricultural Research\",\n  \"displayName\": \"FIELD_OFFICER\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_update",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_update"
          ]
        },
        "description": "The call the catalogue makes on an edit. Replaces: an omitted optional field is cleared. Never re-enables a revoked user."
      }
    },
    {
      "name": "Revoke User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_revoke",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_revoke"
          ]
        },
        "description": "Blocks the account and removes its PIN devices. Create Token then returns 403 disabled, Create Token with PIN 401. Takes the userId, not the email."
      }
    },
    {
      "name": "Enable User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\",\n  \"orgId\": \"org-000000000001\",\n  \"functionalRole\": \"MAKER\",\n  \"email\": \"test.user@example.com\",\n  \"firstName\": \"test\",\n  \"lastName\": \"user\",\n  \"orgName\": \"Ethiopian Institute of Agricultural Research\",\n  \"displayName\": \"FIELD_OFFICER\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_create",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_create"
          ]
        },
        "description": "The call the catalogue makes on publish. Idempotent, and the re-enable path after a revoke. PIN devices are not restored: enrol again."
      }
    },
    {
      "name": "Toggle User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{catalogue_url}}/user/v1/toggle/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "toggle",
            "PASTE_USER_ID"
          ]
        },
        "description": "Catalogue toggle, now synced to auth. First run deactivates (calls auth_user_revoke; Create Token then 401). Second run reactivates (calls auth_user_create)."
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"PASTE_USER_ID\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/v1/auth_user_delete",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "auth_user_delete"
          ]
        },
        "description": "Revokes, then removes the Keycloak user. Create Token then returns 404 not provisioned."
      }
    },
    {
      "name": "Delete Catalogue Record",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{catalogue_url}}/user/v1/delete/PASTE_USER_ID",
          "host": [
            "{{catalogue_url}}"
          ],
          "path": [
            "user",
            "v1",
            "delete",
            "PASTE_USER_ID"
          ]
        },
        "description": "Soft-deletes the catalogue record. The catalogue calls auth_user_delete first, a no-op here after Delete User."
      }
    }
  ],
  "variable": [
    {
      "key": "auth_url",
      "value": "http://18.183.107.166"
    },
    {
      "key": "catalogue_url",
      "value": "http://18.183.107.166"
    },
    {
      "key": "api_key",
      "value": ""
    }
  ]
}